NODE_ENV=development
PORT=3001
API_INTERNAL_PORT=

# Database
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SYNC=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# AWS S3
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mail
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@wedding.local
RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Google
GOOGLE_CLIENT_ID=

# Google Sheets (tuỳ chọn): Web App Apps Script tạo file 2 tab (khách mời).
GOOGLE_SHEETS_APPS_SCRIPT_URL=
GOOGLE_SHEETS_APPS_SCRIPT_SECRET=
# Email Google nhận quyền chỉnh sửa file Sheet (tuỳ chọn, Apps Script có thể dùng để share).
GOOGLE_SHEETS_EDITOR_EMAIL=

# Facebook
FACEBOOK_APP_ID=

# Frontend
FRONTEND_URL=http://localhost:3000

# Thanh toán: payos | vnpay
PAYMENT_PROVIDER=vnpay

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# VNPay (sandbox mặc định trong code nếu không set VNPAY_PAYMENT_URL)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=
PUBLIC_API_BASE_URL=

# Subdomain
INVITE_ROOT_DOMAIN=lumierewedding.vn
# Sau thanh toán (queue): tự tạo bản ghi DNS `{subdomain}.{INVITE_ROOT_DOMAIN}` nếu đủ biến + Cloudflare.
# INVITE_DNS_RECORD_TYPE=A | CNAME
INVITE_DNS_RECORD_TYPE=A
INVITE_DNS_RECORD_CONTENT=
INVITE_DNS_PROXIED=true

# Cloudflare DNS (API tạo bản ghi subdomain — Bearer token + Zone ID)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=