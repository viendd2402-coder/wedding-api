NODE_ENV=development
PORT=3001
API_INTERNAL_PORT=

# Database
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SYNC=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# AWS S3
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mail
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@wedding.local
RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Google
GOOGLE_CLIENT_ID=

# Google Sheets (tuỳ chọn): sau khi thanh toán / tạo thiệp, API tạo file Sheet 2 tab
# (Xác nhận tham dự, Gửi lời chúc tới cô dâu chú rể). Ưu tiên đọc file JSON service account;
# nếu không set path hoặc đọc file lỗi thì dùng biến JSON một dòng bên dưới.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# Email Google nhận quyền chỉnh sửa file Sheet (tuỳ chọn).
GOOGLE_SHEETS_EDITOR_EMAIL=

# Facebook
FACEBOOK_APP_ID=

# Frontend
FRONTEND_URL=http://localhost:3000

# Thanh toán: payos | vnpay
PAYMENT_PROVIDER=vnpay

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# VNPay (sandbox mặc định trong code nếu không set VNPAY_PAYMENT_URL)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=
PUBLIC_API_BASE_URL=